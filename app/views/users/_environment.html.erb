<section aria-label="Environment information" class="mt-12 border-t border-neutral-950 pt-8">
  <div class="flex items-end justify-between gap-6 pb-6">
    <div class="flex flex-col gap-2">
      <p class="text-xs uppercase tracking-[0.14em] text-neutral-400">Environment</p>
      <h2 class="text-xl font-medium tracking-tight sm:text-2xl">Ruby <%= RUBY_VERSION %> · Rails <%= Rails.version %></h2>
    </div>
    <p class="text-xs tabular-nums text-neutral-500"><%= Rails.env %></p>
  </div>

  <div class="grid gap-8 sm:grid-cols-2">
    <% sections.each do |section| %>
      <div>
        <h3 class="mb-3 text-xs uppercase tracking-[0.14em] text-neutral-400"><%= section.heading %></h3>
        <dl class="divide-y divide-neutral-200 border-y border-neutral-200 text-xs">
          <% section.rows.each do |label, value| %>
            <div class="grid grid-cols-[minmax(0,9rem)_minmax(0,1fr)] gap-3 py-2">
              <dt class="text-neutral-500"><%= label %></dt>
              <dd class="break-all tabular-nums"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </div>
    <% end %>
  </div>
</section>
